# URL do projeto no Supabase (Settings > API)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave publicável/anon. Nunca utilize ou exponha a service_role no frontend.
SUPABASE_KEY=sb_publishable_substitua_por_sua_chave

# Gere um valor longo e aleatório antes de publicar a aplicação.
SESSION_SECRET=troque-por-um-segredo-longo-e-aleatorio

# Administração opcional. Gere ADMIN_PASSWORD_HASH com criptografia.gerar_hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=cole-um-hash-pbkdf2-aqui
